# Публичный адрес бэка — браузер (next/image, ссылки). Инлайнится в бандл.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Внутренний адрес бэка для серверных вызовов (route handlers, RSC). В браузер НЕ попадает.
# Локально = тот же адрес; в Docker станет http://backend:3001
API_INTERNAL_URL=http://localhost:3001
